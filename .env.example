# Copy to .env and fill in your own keys. Never commit .env.
# Existing .env values override system environment variables.

# Required for interactive QA (ChatZhipuAI).
ZHIPUAI_API_KEY=
RAG_CHAT_MODEL=glm-4-flash
RAG_LLM_TEMPERATURE=0.1

# Required only for --judge --judge-model deepseek-flash.
# The model name is passed on the command line; use the name supported by your endpoint.
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com

# Local BGE embedding; blank device chooses CUDA when available, otherwise CPU.
RAG_EMBEDDING_MODEL=BAAI/bge-base-zh-v1.5
RAG_EMBEDDING_REVISION=f03589ceff5aac7111bd60cfc7d497ca17ecac65
RAG_EMBEDDING_DEVICE=
RAG_BATCH_SIZE=8

# Retrieval and reranking. Switches use 0=off, 1=on.
RAG_TOP_K=20
RAG_RERANK=1
RAG_RERANK_MODEL=BAAI/bge-reranker-base
RAG_RERANK_TOP_N=5
RAG_RERANK_MAX_LENGTH=512
RAG_RERANK_BATCH_SIZE=16
RAG_RERANK_DEVICE=
RAG_RERANK_WARMUP=0

# Chunking. Changing these settings can create a different index directory.
RAG_CHUNK_STRATEGY=semantic
# Unset tokenizer inherits RAG_RERANK_MODEL. Uncomment only to override.
# RAG_CHUNK_TOKENIZER=BAAI/bge-reranker-base
RAG_CHUNK_TOKENIZER_REVISION=
RAG_CHILD_MAX_TOKENS=320
RAG_CHILD_MIN_TOKENS=64
RAG_PARENT_MAX_TOKENS=1024
RAG_EMBEDDING_MAX_CHARS=480
RAG_SEMANTIC_PERCENTILE=90
RAG_SEMANTIC_BUFFER=1

# Agent context budget; MAX_RETRIES remains a code constant (2).
RAG_PARENT_EXPANSION=1
RAG_MAX_CONTEXT_TOKENS=4096
RAG_MAX_EVIDENCE_DOCS=15
